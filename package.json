{
  "name": "ts-api-harness",
  "version": "0.1.0",
  "description": "A governed agent harness for TypeScript REST APIs",
  "scripts": {
    "setup": "npm ci",
    "harness": "node --import tsx core/cli.ts",
    "test": "vitest run --root test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "express": "^5.2.1",
    "openai": "^7.28.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "bin": {
    "harness": "bin/harness"
  }
}
